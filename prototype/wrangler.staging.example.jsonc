// TEMPLATE ONLY: set the real D1 ID and secrets before choosing this config.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tallshift-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "upload_source_maps": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tallshift-staging"
    }
  ],
  "observability": {
    "enabled": false
  },
  "vars": {
    "APP_ENV": "preview",
    "APP_URL": "https://preview.tallshift.com",
    "AUTH_ENABLED": "false",
    "COMMERCE_ENABLED": "false",
    "TON_PAYMENTS_ENABLED": "false",
    "COMMERCE_DELIVERY_ENABLED": "false"
  },
  // Commerce (disabled). Each step below is a separate cloud change that needs Max Tall's explicit "yes", staging first:
  //  1. Apply migrations 0003_commerce.sql and 0004_commerce_fulfillment.sql to this environment's D1.
  //  2. Private paid files: create a private R2 bucket (no public access, no r2.dev URL, no custom domain) and add
  //     "r2_buckets": [{"binding": "PAID_ARTIFACTS", "bucket_name": "<PRIVATE_PAID_BUCKET>"}]
  //  3. Reconciliation/fulfilment cron: set "main": "src/server/cloudflare/worker-entry.ts" (wraps .open-next/worker.js
  //     and adds scheduled()) and "triggers": {"crons": ["*/5 * * * *"]}.
  //  4. Secrets (never in Git): TONAPI_WEBHOOK_SECRET (webhook hint bearer), optional TONCENTER_API_KEY.
  //  5. Flags last: COMMERCE_DELIVERY_ENABLED, then COMMERCE_ENABLED + TON_PAYMENTS_ENABLED. Sales also stay closed
  //     until src/server/orders/launch.ts has approved terms, tax and FX and the paid release registry is non-empty.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tallshift-db-staging",
      "database_id": "<SET_REAL_STAGING_DATABASE_ID>",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "preview.tallshift.com",
      "custom_domain": true
    }
  ]
}
